    "See your Mac's latest system metrics at a glance.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta de un vistazo las mediciones más recientes del Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultez les dernières mesures de votre Mac en un coup d’œil."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja as medições mais recentes do Mac em um relance."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основные показатели Mac — одним взглядом."
