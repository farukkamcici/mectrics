  "sourceLanguage": "en",
  "strings": {
    "Launch the app once to show live readings.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la app una vez para ver las mediciones en tiempo real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez l’app une fois pour afficher les mesures en temps réel."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o app uma vez para ver as medições em tempo real."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте приложение один раз, чтобы увидеть актуальные данные."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Canlı ölçümleri görmek için uygulamayı bir kez açın."
          }
        }
      }
    },
