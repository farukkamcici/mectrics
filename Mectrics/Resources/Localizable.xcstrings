    "Send a Test Notification": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Test Bildirimi Gönder"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar una notificación de prueba"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyer une notification de test"
          }
        },
        "pt-BR": {
