    "A calmer view of Mac health": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una forma más tranquila de ver el estado del Mac"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une vue plus sereine de l’état de votre Mac"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma visão mais tranquila do estado do Mac"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спокойный и понятный обзор состояния Mac"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac’inizin durumunu sakin ve anlaşılır biçimde izleyin"
          }
        }
      }
    },
    "A lightweight, private system monitor for Mac.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un monitor del sistema ligero y privado para Mac."
